{
  "name": "horas-complementares",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Controle de horas complementares da turma de Psicologia — Técnicas de Observação",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "banco:criar": "wrangler d1 create horas-complementares",
    "banco:migrar": "wrangler d1 execute horas-complementares --remote --file=src/esquema.sql",
    "deploy": "wrangler deploy",
    "banco:ver": "node scripts/ver-banco.mjs",
    "banco:backup": "wrangler d1 export horas-complementares --remote --output=backup-horas.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
